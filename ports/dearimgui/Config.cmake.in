@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@BACKEND_OPENGL2@ OR @BACKEND_OPENGL3@)
    # the target links to OpenGL::GL, which is resolved on the consumer side
    find_dependency(OpenGL)
endif()

if(@BACKEND_VULKAN@)
    # the target links to Vulkan::Vulkan, which is resolved on the consumer side
    find_dependency(Vulkan)
endif()

if(@BACKEND_GLFW@)
    find_dependency(glfw3 CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
