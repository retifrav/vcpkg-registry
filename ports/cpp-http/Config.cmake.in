@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# quoted, as these are not set at all without the corresponding feature

if("@HTTPLIB_IS_USING_BROTLI@")
    find_dependency(brotli CONFIG REQUIRED)
endif()

if("@HTTPLIB_IS_USING_OPENSSL@")
    find_dependency(OpenSSL CONFIG REQUIRED)
endif()

if("@HTTPLIB_IS_USING_ZLIB@")
    find_dependency(zlib CONFIG REQUIRED)
endif()

if("@HTTPLIB_IS_USING_ZSTD@")
    find_dependency(zstd CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
