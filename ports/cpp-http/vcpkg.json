{
    "name": "cpp-http",
    "version": "0.67.0",
    "description": "Header-only HTTP/HTTPS server and client library",
    "homepage": "https://github.com/yhirose/cpp-httplib",
    "license": "MIT",
    "dependencies":
    [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        },
        {
            "name": "decovar-vcpkg-cmake",
            "host": true
        }
    ],
    "default-features":
    [
        "brotli",
        "zlib",
        "zstd"
    ],
    "features":
    {
        "brotli":
        {
            "description": "Brotli compression support",
            "dependencies":
            [
                "brotli"
            ]
        },
        "openssl":
        {
            "description": "HTTPS support via OpenSSL",
            "dependencies":
            [
                "openssl"
            ]
        },
        "zlib":
        {
            "description": "gzip compression support",
            "dependencies":
            [
                {
                    "name": "zlib",
                    "version>=": "1.3.2"
                }
            ]
        },
        "zstd":
        {
            "description": "Zstandard compression support",
            "dependencies":
            [
                "zstd"
            ]
        }
    }
}
