@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@JPEG_SUPPORT@)
    find_dependency(jpeg-turbo CONFIG REQUIRED)
endif()
if(@LZMA_SUPPORT@)
    find_dependency(xz CONFIG REQUIRED)
endif()
if(@WEBP_SUPPORT@)
    find_dependency(WebP CONFIG REQUIRED)
endif()
if(@ZLIB_SUPPORT@)
    find_dependency(zlib CONFIG REQUIRED)
    find_dependency(deflate CONFIG REQUIRED)
endif()
if(@ZSTD_SUPPORT@)
    find_dependency(zstd CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
