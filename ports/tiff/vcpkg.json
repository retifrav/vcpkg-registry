{
    "name": "tiff",
    "version": "4.7.2",
    "description": "Tag Image File Format (TIFF), a widely used format for storing image data",
    "homepage": "http://libtiff.org/",
    "license": "libtiff",
    "dependencies":
    [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        }
    ],
    "default-features":
    [
        "jpeg",
        "zip",
        "zstandard"
    ],
    "features":
    {
        "cxx":
        {
            "description": "Build C++ libtiffxx library",
            "supports": "!arm"
        },
        "jpeg":
        {
            "description": "Enable JPEG support",
            "dependencies":
            [
                {
                    "name": "jpeg-turbo",
                    "version>=": "3.2.0"
                }
            ]
        },
        "lzma":
        {
            "description": "Enable LZMA2 compression",
            "dependencies":
            [
                "xz"
            ]
        },
        "webp":
        {
            "description": "Enable WebP support",
            "dependencies":
            [
                "webp"
            ]
        },
        "zip":
        {
            "description": "Enable ZIP/deflate compression",
            "dependencies":
            [
                "deflate",
                {
                    "name": "zlib",
                    "version>=": "1.3.2"
                }
            ]
        },
        "zstandard":
        {
            "description": "Enable Zstandard compression",
            "dependencies":
            [
                "zstd"
            ]
        }
    }
}
