@@ -843,3 +843,34 @@
 
 # Remove the default "lib" prefix from the resulting library.
 set_target_properties(${CEF_TARGET} PROPERTIES PREFIX "")
+
+include(GNUInstallDirs)
+include(CMakePackageConfigHelpers)
+
+# install the target(s) and create export-set
+install(TARGETS ${CEF_TARGET}
+    EXPORT "${CEF_TARGET}Targets"
+    #RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} # bin
+    #LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} # lib
+    #ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} # lib
+    PUBLIC_HEADER DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/cef" # include/SomeLibrary
+    #INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} # include
+)
+install(EXPORT "${CEF_TARGET}Targets"
+    FILE "${CEF_TARGET}Targets.cmake"
+    NAMESPACE "cef::"
+    DESTINATION "share/${CEF_TARGET}"
+)
+
+# create config file
+configure_package_config_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/Config.cmake.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/${CEF_TARGET}Config.cmake"
+    INSTALL_DESTINATION "share/${CEF_TARGET}"
+)
+
+# install config files
+install(FILES
+    "${CMAKE_CURRENT_BINARY_DIR}/${CEF_TARGET}Config.cmake"
+    DESTINATION "share/${CEF_TARGET}"
+)
