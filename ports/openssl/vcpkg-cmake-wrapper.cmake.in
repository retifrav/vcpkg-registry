cmake_policy(PUSH)
cmake_policy(SET CMP0012 NEW)
cmake_policy(SET CMP0054 NEW)
cmake_policy(SET CMP0057 NEW)

set(OPENSSL_VERSION_MAJOR @OPENSSL_VERSION_MAJOR@)
set(OPENSSL_VERSION_MINOR @OPENSSL_VERSION_MINOR@)
set(OPENSSL_VERSION_FIX @OPENSSL_VERSION_FIX@)

if(OPENSSL_USE_STATIC_LIBS)
    if("@VCPKG_LIBRARY_LINKAGE@" STREQUAL "dynamic")
        message(WARNING "OPENSSL_USE_STATIC_LIBS is set, but OpenSSL vcpkg port was built with dynamic linkage")
    endif()
    set(OPENSSL_USE_STATIC_LIBS_BAK "${OPENSSL_USE_STATIC_LIBS}")
    set(OPENSSL_USE_STATIC_LIBS FALSE)
endif()

if(DEFINED OPENSSL_ROOT_DIR)
    set(OPENSSL_ROOT_DIR_BAK "${OPENSSL_ROOT_DIR}")
endif()
get_filename_component(OPENSSL_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}" DIRECTORY)
get_filename_component(OPENSSL_ROOT_DIR "${OPENSSL_ROOT_DIR}" DIRECTORY)
find_path(OPENSSL_INCLUDE_DIR NAMES openssl/ssl.h PATH "${OPENSSL_ROOT_DIR}/include" NO_DEFAULT_PATH)
# the installed OpenSSLConfig.cmake does the same (see cmake-config.patch), so keep the two in sync
find_library(LIB_EAY_DEBUG
    NAMES
        libcrypto
        crypto
    NAMES_PER_DIR
    PATHS "${OPENSSL_ROOT_DIR}/debug/lib"
    NO_DEFAULT_PATH
)
find_library(LIB_EAY_RELEASE
    NAMES
        libcrypto
        crypto
    NAMES_PER_DIR
    PATHS "${OPENSSL_ROOT_DIR}/lib"
    NO_DEFAULT_PATH
)
find_library(SSL_EAY_DEBUG
    NAMES
        libssl
        ssl
    NAMES_PER_DIR
    PATHS "${OPENSSL_ROOT_DIR}/debug/lib"
    NO_DEFAULT_PATH
)
find_library(SSL_EAY_RELEASE
    NAMES
        libssl
        ssl
    NAMES_PER_DIR
    PATHS "${OPENSSL_ROOT_DIR}/lib"
    NO_DEFAULT_PATH
)
get_property(Z_VCPKG_OPENSSL_MULTI_CONFIG GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(NOT MSVC)
    # FindOpenSSL.cmake sets these by itself only for MSVC, but uses them for the targets anywhere
    set(LIB_EAY_LIBRARY_DEBUG "${LIB_EAY_DEBUG}")
    set(LIB_EAY_LIBRARY_RELEASE "${LIB_EAY_RELEASE}")
    set(SSL_EAY_LIBRARY_DEBUG "${SSL_EAY_DEBUG}")
    set(SSL_EAY_LIBRARY_RELEASE "${SSL_EAY_RELEASE}")
    if(Z_VCPKG_OPENSSL_MULTI_CONFIG)
        unset(OPENSSL_CRYPTO_LIBRARY)
        unset(OPENSSL_SSL_LIBRARY)
    endif()
    if(WIN32)
        find_library(LIB_EAY NAMES libcrypto crypto NAMES_PER_DIR)
        find_library(SSL_EAY NAMES libssl ssl NAMES_PER_DIR)
    else()
        find_library(OPENSSL_CRYPTO_LIBRARY NAMES crypto)
        find_library(OPENSSL_SSL_LIBRARY NAMES ssl)
    endif()
endif()

_find_package(${ARGS})

unset(OPENSSL_ROOT_DIR)
if(DEFINED OPENSSL_ROOT_DIR_BAK)
    set(OPENSSL_ROOT_DIR "${OPENSSL_ROOT_DIR_BAK}")
    unset(OPENSSL_ROOT_DIR_BAK)
endif()

if(DEFINED OPENSSL_USE_STATIC_LIBS_BAK)
    set(OPENSSL_USE_STATIC_LIBS "${OPENSSL_USE_STATIC_LIBS_BAK}")
    unset(OPENSSL_USE_STATIC_LIBS_BAK)
endif()

if(OPENSSL_FOUND AND "@VCPKG_LIBRARY_LINKAGE@" STREQUAL "static")
    if(WIN32)
        list(APPEND OPENSSL_LIBRARIES crypt32 ws2_32)
        if(TARGET OpenSSL::Crypto)
            set_property(TARGET OpenSSL::Crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES "crypt32;ws2_32")
        endif()
        if(TARGET OpenSSL::SSL)
            set_property(TARGET OpenSSL::SSL APPEND PROPERTY INTERFACE_LINK_LIBRARIES "crypt32;ws2_32")
        endif()
    else()
        find_library(OPENSSL_DL_LIBRARY NAMES dl)
        if(OPENSSL_DL_LIBRARY)
            list(APPEND OPENSSL_LIBRARIES "dl")
            if(TARGET OpenSSL::Crypto)
                set_property(TARGET OpenSSL::Crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES "dl")
            endif()
        endif()

        if("REQUIRED" IN_LIST ARGS)
           find_package(Threads REQUIRED)
        else()
           find_package(Threads)
        endif()
        list(APPEND OPENSSL_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
        if(TARGET OpenSSL::Crypto)
            set_property(TARGET OpenSSL::Crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads")
        endif()
        if(TARGET OpenSSL::SSL)
            set_property(TARGET OpenSSL::SSL APPEND PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads")
        endif()
    endif()
endif()

# with a multi-config generator (Xcode, Ninja Multi-Config) the variables need both configurations,
# like FindOpenSSL.cmake already makes them for MSVC
if(
    OPENSSL_FOUND
    AND
    NOT MSVC
    AND
    Z_VCPKG_OPENSSL_MULTI_CONFIG
    AND
    LIB_EAY_LIBRARY_DEBUG
    AND
    LIB_EAY_LIBRARY_RELEASE
    AND
    SSL_EAY_LIBRARY_DEBUG
    AND
    SSL_EAY_LIBRARY_RELEASE
)
    foreach(Z_VCPKG_OPENSSL_VAR
        IN ITEMS
            OPENSSL_CRYPTO_LIBRARIES
            OPENSSL_SSL_LIBRARIES
            OPENSSL_LIBRARIES
    )
        string(REPLACE
            "${OPENSSL_CRYPTO_LIBRARY}"
            "optimized;${LIB_EAY_LIBRARY_RELEASE};debug;${LIB_EAY_LIBRARY_DEBUG}"
            ${Z_VCPKG_OPENSSL_VAR}
            "${${Z_VCPKG_OPENSSL_VAR}}"
        )
        string(REPLACE
            "${OPENSSL_SSL_LIBRARY}"
            "optimized;${SSL_EAY_LIBRARY_RELEASE};debug;${SSL_EAY_LIBRARY_DEBUG}"
            ${Z_VCPKG_OPENSSL_VAR}
            "${${Z_VCPKG_OPENSSL_VAR}}"
        )
    endforeach()
    unset(Z_VCPKG_OPENSSL_VAR)
    set(OPENSSL_CRYPTO_LIBRARY
        optimized "${LIB_EAY_LIBRARY_RELEASE}"
        debug "${LIB_EAY_LIBRARY_DEBUG}"
    )
    set(OPENSSL_SSL_LIBRARY
        optimized "${SSL_EAY_LIBRARY_RELEASE}"
        debug "${SSL_EAY_LIBRARY_DEBUG}"
    )
endif()
unset(Z_VCPKG_OPENSSL_MULTI_CONFIG)
cmake_policy(POP)
